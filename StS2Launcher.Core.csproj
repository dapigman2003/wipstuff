<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Step 05.14 retains SteamKit2 3.4.0 and adds only SteamKit DebugLog capture
      around the already-isolated CM WebSocket connection failure. No authentication
      or additional runtime subsystem is introduced.
    -->
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>
</Project>
