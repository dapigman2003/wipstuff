<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>

    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>

    <ApplicationId>com.community.sts2launcher</ApplicationId>
    <ApplicationTitle>StS2 Launcher</ApplicationTitle>
    <ApplicationVersion>21</ApplicationVersion>
    <ApplicationDisplayVersion>0.0.21</ApplicationDisplayVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Step 05.1 proved that TrimMode=full alone does not prevent the .NET iOS
      native-link pipeline from inferring DiskArbitration from SteamKit2's
      macOS-only machine-information P/Invokes.

      Keep full trimming for the app overall. Step 05.14 proved the actual
      post-connect failure is protobuf-net reflecting over SteamKit-generated
      protobuf metadata after full trimming removed a required property getter.
      Step 05.15 roots only the three assemblies participating in that reflective
      serialization path; all other assemblies remain fully trimmed.

      Step 05.15 also retains Step 05.2's generated DiskArbitration framework
      filter and the isolated SteamKit Process.StartTime compatibility patch.
    -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../StS2Launcher.Core/StS2Launcher.Core.csproj" />
  </ItemGroup>

  <!--
    Step 05.15 single compatibility change: protobuf-net builds its runtime
    serializer by reflecting over its own contract attributes and SteamKit's
    generated protobuf message properties. Preserve those assemblies so iOS
    full trimming cannot remove accessors that are reached only by reflection.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="SteamKit2" />
    <TrimmerRootAssembly Include="protobuf-net" />
    <TrimmerRootAssembly Include="protobuf-net.Core" />
  </ItemGroup>

  <!--
    _LinkerFrameworks is emitted by the .NET iOS linker. This target is
    intentionally narrow: it removes only DiskArbitration and leaves all
    other inferred Apple frameworks untouched.
  -->
  <Target Name="Step052RemoveMacOnlyDiskArbitrationFramework"
          AfterTargets="_LoadLinkerOutput"
          BeforeTargets="_ComputeLinkNativeExecutableInputs">
    <Message Importance="High"
             Text="STEP05.2 LINKER FRAMEWORKS BEFORE: @(_LinkerFrameworks, ',')" />

    <ItemGroup>
      <_LinkerFrameworks Remove="DiskArbitration" />
    </ItemGroup>

    <Message Importance="High"
             Text="STEP05.2 LINKER FRAMEWORKS AFTER: @(_LinkerFrameworks, ',')" />

  </Target>
</Project>
