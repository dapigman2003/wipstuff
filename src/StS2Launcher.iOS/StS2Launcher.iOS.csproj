<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <RootNamespace>StS2Launcher.iOS</RootNamespace>
    <AssemblyName>StS2Launcher.iOS</AssemblyName>

    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>

    <ApplicationId>com.community.sts2launcher</ApplicationId>
    <ApplicationTitle>StS2 Launcher</ApplicationTitle>
    <ApplicationVersion>65</ApplicationVersion>
    <ApplicationDisplayVersion>0.0.65</ApplicationDisplayVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Step 15 retains the final Step 05 policy: keep full trimming globally, while preserving the
      three assemblies protobuf-net reflects over during SteamKit message
      serialization. Physical-iPhone Step 05.15 proved this is required for
      the initial ClientHello path.
    -->
    <TrimMode>full</TrimMode>

    <!--
      Step 21 retains the physically proven Step 20 Dynamic Managed Execution Foundation interpreter policy: keep every build-time launcher assembly on
      the already-proven AOT path while linking the Mono interpreter into the Release host for
      runtime/dynamic managed code. Microsoft documents MtouchInterpreter=-all as "AOT compile
      all assemblies, while still allowing the interpreter to perform dynamic code generation".
      The Step 20 fixture DLLs are copied only after dotnet publish and are never project/content
      references, so physical Gate B is the authority for whether post-publish IL can execute.
      PublishAot/NativeAOT remains disabled.
    -->
    <MtouchInterpreter>-all</MtouchInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../StS2Launcher.Core/StS2Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="SteamKit2" />
    <TrimmerRootAssembly Include="protobuf-net" />
    <TrimmerRootAssembly Include="protobuf-net.Core" />
  </ItemGroup>

  <!--
    Step 22 Host Framework Closure Foundation. The physical Step 21.1 report showed that every
    remaining dependency blocker was a framework-shaped assembly whose only workspace fallback
    was a non-IL-only macOS runtime image. These 22 measured seed roots keep the corresponding
    iOS/.NET host framework contracts (and their statically understood dependencies) in the
    fully-trimmed Release app. The larger 44-name observed frontier is verified on-device before
    the Step 21 binding plan is recomputed. No downloaded System.* implementation is added here.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="netstandard" />
    <TrimmerRootAssembly Include="System.Data.Common" />
    <TrimmerRootAssembly Include="System.Diagnostics.Contracts" />
    <TrimmerRootAssembly Include="System.Diagnostics.StackTrace" />
    <TrimmerRootAssembly Include="System.Diagnostics.TraceSource" />
    <TrimmerRootAssembly Include="System.Diagnostics.Tracing" />
    <TrimmerRootAssembly Include="System.IO.FileSystem.DriveInfo" />
    <TrimmerRootAssembly Include="System.IO.MemoryMappedFiles" />
    <TrimmerRootAssembly Include="System.Net.Ping" />
    <TrimmerRootAssembly Include="System.Net.Quic" />
    <TrimmerRootAssembly Include="System.Numerics.Vectors" />
    <TrimmerRootAssembly Include="System.Reflection.Metadata" />
    <TrimmerRootAssembly Include="System.Runtime.CompilerServices.Unsafe" />
    <TrimmerRootAssembly Include="System.Runtime.Loader" />
    <TrimmerRootAssembly Include="System.Runtime.Serialization.Json" />
    <TrimmerRootAssembly Include="System.Runtime.Serialization.Primitives" />
    <TrimmerRootAssembly Include="System.Runtime.Serialization.Xml" />
    <TrimmerRootAssembly Include="System.Threading.Tasks.Parallel" />
    <TrimmerRootAssembly Include="System.Threading.ThreadPool" />
    <TrimmerRootAssembly Include="System.Xml.XDocument" />
    <TrimmerRootAssembly Include="System.Xml.XmlSerializer" />
    <TrimmerRootAssembly Include="System.Xml.XPath" />
  </ItemGroup>

  <Target Name="ValidateRuntimeAndFrameworkRootPolicy" BeforeTargets="PrepareForBuild">
    <Message Importance="High"
             Text="STEP23 RUNTIME POLICY: MtouchInterpreter=$(MtouchInterpreter); UseInterpreter=$(UseInterpreter); PublishAot=$(PublishAot)" />
    <Error Condition="'$(MtouchInterpreter)' != '-all'"
           Text="Canonical foundation preserves the Step 20/21 requirement MtouchInterpreter=-all so build-time assemblies remain AOT-targeted while the interpreter stays available for runtime/dynamic managed code." />
    <Error Condition="'$(UseInterpreter)' == 'true'"
           Text="Canonical foundation preserves the Step 20/21 prohibition on UseInterpreter=true because it is the broader interpret-all build-time policy." />
    <Error Condition="'$(PublishAot)' == 'true'"
           Text="Canonical foundation requires the Mono runtime; NativeAOT is incompatible with the Mono interpreter proof." />
  </Target>

  <!--
    Step 15 Godot Foundation: Codemagic builds a pinned Godot 4.5.1-stable
    arm64 iOS static archive into NativeBuild before dotnet publish. The
    archive contains only upstream Godot + the project-owned Step 15 bridge;
    no StS2 game files or proprietary FMOD/Spine binaries are bundled.
  -->
  <ItemGroup Condition="Exists('NativeBuild/libgodot-step15.a')">
    <NativeReference Include="NativeBuild/libgodot-step15.a">
      <Kind>Static</Kind>
      <!-- Do not force-load the combined Godot archive. Godot contains mutually exclusive/width-specific third-party object members (for example PCRE2 16/32-bit helpers) that are safe under normal static-archive selection but collide if every member is pulled into the final link. The explicit bridge references plus -ObjC are the intended roots. -->
      <ForceLoad>false</ForceLoad>
      <SmartLink>false</SmartLink>
      <IsCxx>true</IsCxx>
      <!-- Godot includes AudioUnit headers while compiling iOS audio code, but Xcode 26.5 does not expose AudioUnit as a standalone linkable iPhoneOS framework. The C Audio Unit symbols are supplied by AudioToolbox; do not add AudioUnit here. -->
      <Frameworks>Accelerate AudioToolbox AVFoundation CFNetwork CoreAudio CoreFoundation CoreGraphics CoreHaptics CoreLocation CoreMedia CoreMotion CoreText CoreVideo Foundation GameController ImageIO MediaPlayer Metal MetalFX MetalKit OpenGLES QuartzCore Security SystemConfiguration UIKit UniformTypeIdentifiers VideoToolbox WebKit</Frameworks>
      <LinkerFlags>-ObjC -lz</LinkerFlags>
    </NativeReference>
  </ItemGroup>

  <!--
    .NET 9 iOS build item designed to root native static symbols without force-loading
    the entire combined Godot archive. Keep this list exactly aligned with the
    managed DllImport("__Internal") Step 15 entry points.
  -->
  <ItemGroup Condition="Exists('NativeBuild/libgodot-step15.a')">
    <ReferenceNativeSymbol Include="sts2_step15_background_count" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_focus_in_count" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_focus_out_count" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_foreground_count" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_get_engine_version" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_is_engine_started" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_is_metal_layer_ready" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_is_rendering_active" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_is_setup_finished" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_last_error" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_render_marker_ready" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_requires_process_restart" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_start" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_start_rendering" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_stop_rendering" SymbolType="Function" />
    <ReferenceNativeSymbol Include="sts2_step15_touch_marker_ready" SymbolType="Function" />
  </ItemGroup>

  <!--
    SteamKit carries macOS-only machine-information P/Invokes that cause the
    .NET iOS linker to infer DiskArbitration.framework. iPhoneOS does not ship
    that framework, so remove only this generated framework item after linker
    output is loaded and before native link inputs are computed.
  -->
  <Target Name="Step052RemoveMacOnlyDiskArbitrationFramework"
          AfterTargets="_LoadLinkerOutput"
          BeforeTargets="_ComputeLinkNativeExecutableInputs">
    <Message Importance="High"
             Text="STEP05.2 LINKER FRAMEWORKS BEFORE: @(_LinkerFrameworks, ',')" />
    <ItemGroup>
      <_LinkerFrameworks Remove="DiskArbitration" />
    </ItemGroup>
    <Message Importance="High"
             Text="STEP05.2 LINKER FRAMEWORKS AFTER: @(_LinkerFrameworks, ',')" />
  </Target>
</Project>
