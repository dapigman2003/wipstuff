<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Step 05.15 retains SteamKit2 3.4.0. The only new compatibility change is
      in the iOS project: preserve the reflective protobuf assemblies from full
      trimming. DebugLog/connection diagnostics remain unchanged. No authentication
      or additional runtime subsystem is introduced.
    -->
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>
</Project>
