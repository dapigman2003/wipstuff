<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Step 05.13 retains SteamKit2 3.4.0 and only localizes the remaining
      Reflection.Emit failure to a SteamKit setup/connect stage. No additional
      runtime capability is introduced.
    -->
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>
</Project>
